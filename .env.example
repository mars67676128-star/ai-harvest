# The application and bundled launchers do not automatically load this file.
# Set environment variables explicitly, or use your deployment's env-file support.
HARVEST_ENV=demo
HARVEST_DB=data/harvest.db

# SIFU does NOT fall back to canned answers. Leave mock for UI-only development,
# or configure a live OpenAI-compatible provider before using Ask Sifu.
HARVEST_LLM_PROVIDER=mock
# For live Tencent: set provider=tencent and configure your console's enabled model.
HARVEST_LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
HARVEST_LLM_MODEL=
HARVEST_LLM_API_KEY=
HARVEST_LLM_TIMEOUT=25
HARVEST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Company-managed routing data. This is configuration, not model-generated authority.
# Example only — replace with your organisation's actual people and expertise.
# SIFU_EXPERT_DIRECTORY=[{"id":"tan","name":"Tan Wei Ming","role":"Senior M&E Technician","skills":["sump systems","drainage","pump maintenance"],"domains":["Technical Services"]},{"id":"marcus","name":"Marcus Lee","role":"BMS Engineer","skills":["BMS telemetry","control logic","sensor anomalies"],"domains":["Technical Services"]}]
SIFU_EXPERT_DIRECTORY=[]
SIFU_MAX_KNOWLEDGE_ITEMS=20

# Required for HARVEST_ENV=production. Use long random tokens; never commit real ones.
# HARVEST_AUTH_TOKENS={"random-token":{"id":"alice","roles":["expert"]}}
