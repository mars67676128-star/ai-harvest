# The application and bundled launchers do not automatically load this file.
# Set environment variables explicitly, or use your deployment's env-file support.
HARVEST_ENV=demo
HARVEST_DB=data/harvest.db

# SIFU does NOT fall back to canned answers. Leave mock for UI-only development,
# or switch to openai for live Ask Sifu reasoning.
# GPT-6 Luna is the default because it supports reasoning + structured outputs at low cost.
HARVEST_LLM_PROVIDER=mock
HARVEST_LLM_BASE_URL=https://api.openai.com/v1
HARVEST_LLM_MODEL=gpt-6-luna
HARVEST_LLM_API_KEY=
HARVEST_LLM_REASONING_EFFORT=high
HARVEST_LLM_TIMEOUT=60
HARVEST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Company-managed routing data. This is configuration, not model-generated authority.
# In the local demo, use id "expert" for Tan so it matches the demo-expert actor.
# SIFU_EXPERT_DIRECTORY=[{"id":"expert","name":"Tan Wei Ming","role":"Senior M&E Technician","skills":["sump systems","drainage","pump maintenance"],"domains":["Technical Services"]}]
SIFU_EXPERT_DIRECTORY=[]

# Each governed domain maps to exactly one Knowledge Owner. The configured actor must
# have the approver role. In the local demo, "approver" maps to demo-approver.
# SIFU_KNOWLEDGE_OWNERS=[{"id":"approver","name":"Jennifer Lim","domains":["Technical Services"]}]
SIFU_KNOWLEDGE_OWNERS=[]

SIFU_MAX_KNOWLEDGE_ITEMS=20

# Required for HARVEST_ENV=production. Use long random tokens; never commit real ones.
# HARVEST_AUTH_TOKENS={"random-token":{"id":"alice","roles":["expert"]}}
