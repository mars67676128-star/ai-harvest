# The application and bundled launchers do not automatically load this file.
# Set environment variables explicitly, or use your deployment's env-file support.
HARVEST_ENV=demo
HARVEST_DB=data/harvest.db
HARVEST_LLM_PROVIDER=mock
# To use a live Tencent-compatible model (e.g. Tencent Hunyuan via TencentCloud MaaS):
#   1. Set HARVEST_LLM_PROVIDER=tencent
#   2. Set HARVEST_LLM_MODEL to your console's enabled model name (e.g. hunyuan-pro)
#   3. Set HARVEST_LLM_API_KEY to your server-side API key (NEVER commit real keys)
#   4. Set HARVEST_LLM_BASE_URL if using a different Tencent-compatible endpoint
HARVEST_LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
HARVEST_LLM_MODEL=
HARVEST_LLM_API_KEY=
HARVEST_LLM_TIMEOUT=25
HARVEST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Required for HARVEST_ENV=production. Use long random tokens; never commit real ones.
# HARVEST_AUTH_TOKENS={"random-token":{"id":"alice","roles":["expert"]}}
